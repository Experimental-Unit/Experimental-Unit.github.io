{
  "name": "@local/substack-pipeline-skill",
  "version": "1.0.0",
  "description": "OpenClaw skill for Substack archive processing pipeline",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsdown src/index.ts -d dist",
    "dev": "tsdown src/index.ts -d dist --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "openclaw",
    "skill",
    "substack",
    "langchain",
    "pipeline"
  ],
  "openclaw": {
    "skill": true,
    "displayName": "Substack Pipeline",
    "description": "Process Substack archives with AI-powered summaries, glossary extraction, and static site generation",
    "tools": [
      "substack.load",
      "substack.process",
      "substack.summarize",
      "substack.glossary",
      "substack.entities",
      "substack.search",
      "substack.generate-site"
    ]
  },
  "dependencies": {
    "@openclaw/sdk": "^2026.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.4.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
