{
  "$schema": "https://docs.openclaw.ai/schema/openclaw.json",
  "agent": {
    "model": "anthropic/claude-sonnet-4-20250514",
    "fallbackModels": [
      "anthropic/claude-3-haiku-20240307",
      "openai/gpt-4o-mini"
    ],
    "temperature": 0.3,
    "maxTokens": 4096
  },
  "gateway": {
    "host": "127.0.0.1",
    "port": 18789,
    "enableWebSocket": true,
    "enableREST": true
  },
  "workspace": {
    "path": "./workspace",
    "projectRoot": ".."
  },
  "sandbox": {
    "enabled": true,
    "mode": "docker",
    "allowedPaths": [
      "../data",
      "../output",
      "../site",
      "../pipeline"
    ],
    "deniedTools": []
  },
  "skills": {
    "enabled": [
      "@openclaw/core",
      "@openclaw/browser",
      "@openclaw/fs",
      "@openclaw/git",
      "./skills/substack-pipeline"
    ],
    "autoInstall": true
  },
  "channels": {
    "webchat": {
      "enabled": true,
      "port": 18790
    },
    "cli": {
      "enabled": true
    }
  },
  "github": {
    "enabled": true,
    "autoCommit": false,
    "branchPrefix": "openclaw/",
    "prTemplate": ".github/PULL_REQUEST_TEMPLATE.md"
  },
  "logging": {
    "level": "info",
    "file": "./logs/openclaw.log",
    "maxSize": "10mb",
    "maxFiles": 5
  }
}
